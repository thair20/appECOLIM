<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Forzamos tema claro siempre: el diseño de ECOLIM (mockup) es 100% claro
         y no tiene variantes oscuras definidas, así que evitamos que el modo
         oscuro del sistema rompa contrastes de texto. -->
    <style name="Base.Theme.ECOLIM" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary_green</item>
        <item name="colorPrimaryDark">@color/primary_green_dark</item>
        <item name="colorAccent">@color/accent_orange</item>
    </style>

    <style name="Theme.ECOLIM" parent="Base.Theme.ECOLIM" />
</resources>
