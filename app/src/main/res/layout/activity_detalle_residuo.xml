<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ecolim"
    android:orientation="vertical">

    <!-- Barra Superior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/primary_green"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Detalle de Residuo"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tipo de Residuo"
                android:textColor="#000000"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etTipoResiduo"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@color/white"
                android:hint="Ej. Plástico PET / Industrial"
                android:inputType="text"
                android:textColor="#000000"
                android:textColorHint="#787878"
                android:paddingStart="12dp"
                android:textSize="14sp" />

            <Space android:layout_width="match_parent" android:layout_height="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cantidad (kg)"
                android:textColor="#000000"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etCantidadResiduo"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@color/white"
                android:hint="Ej. 120.87"
                android:inputType="numberDecimal"
                android:textColor="#000000"
                android:textColorHint="#787878"
                android:paddingStart="12dp"
                android:textSize="14sp" />

            <Space android:layout_width="match_parent" android:layout_height="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Estado de Contención"
                android:textColor="#000000"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etEstadoContencion"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@color/white"
                android:hint="Ej. Empacado y Sellado"
                android:inputType="text"
                android:textColor="#000000"
                android:textColorHint="#787878"
                android:paddingStart="12dp"
                android:textSize="14sp" />

        </LinearLayout>
    </ScrollView>

    <!-- Botón Inferior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:padding="16dp">

        <Button
            android:id="@+id/btnGuardarContinuarResiduo"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:backgroundTint="@color/primary_green"
            android:text="GUARDAR Y CONTINUAR"
            android:textColor="@color/white"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>