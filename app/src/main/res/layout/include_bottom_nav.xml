<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="@color/white"
    android:elevation="8dp"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/navInicio"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🏠" android:textSize="18sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Inicio" android:textColor="@color/primary_green" android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navRecolecciones"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🚛" android:textSize="18sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Recolecciones" android:textColor="@color/text_secondary" android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navReportes"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📊" android:textSize="18sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Reportes" android:textColor="@color/text_secondary" android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navMas"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⋯" android:textSize="18sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Más" android:textColor="@color/text_secondary" android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
