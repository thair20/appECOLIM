<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ecolim"
    android:orientation="vertical">

    <!-- Barra Superior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/primary_green"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Confirmación"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Tarjeta de Resumen con fondo blanco sólido para legibilidad -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Resumen del Servicio"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Space android:layout_width="match_parent" android:layout_height="12dp" />

                <TextView
                    android:id="@+id/tvResumenCliente"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cliente: Cargando..."
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Space android:layout_width="match_parent" android:layout_height="6dp" />

                <TextView
                    android:id="@+id/tvResumenFecha"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fecha: Cargando..."
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Space android:layout_width="match_parent" android:layout_height="6dp" />

                <TextView
                    android:id="@+id/tvResumenResiduo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Residuo: Cargando..."
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Space android:layout_width="match_parent" android:layout_height="6dp" />

                <TextView
                    android:id="@+id/tvResumenCantidad"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cantidad Total: 0 kg"
                    android:textColor="@color/primary_green"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Botón Inferior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:padding="16dp">

        <Button
            android:id="@+id/btnFinalizarRegistrar"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:backgroundTint="@color/primary_green"
            android:text="ENVIAR, SUBIR Y REGISTRAR"
            android:textColor="@color/white"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>