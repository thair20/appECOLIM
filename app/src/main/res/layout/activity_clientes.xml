<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    orientation="vertical"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/primary_green"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gestión de Clientes"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre del Cliente / Empresa"
                android:textColor="@color/dark_text"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etNombreCliente"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@color/white"
                android:hint="Ej. Empresa Recicla S.A.C."
                android:paddingStart="12dp"
                android:textSize="14sp" />

            <Space android:layout_width="match_parent" android:layout_height="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dirección"
                android:textColor="@color/dark_text"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etDireccionCliente"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@color/white"
                android:hint="Ej. Av. Industrial 123"
                android:paddingStart="12dp"
                android:textSize="14sp" />

            <Space android:layout_width="match_parent" android:layout_height="16dp" />

            <Button
                android:id="@+id/btnGuardarCliente"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:backgroundTint="@color/primary_green"
                android:text="REGISTRAR CLIENTE"
                android:textColor="@color/white"
                android:textStyle="bold" />

            <Space android:layout_width="match_parent" android:layout_height="24dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clientes Registrados"
                android:textColor="@color/dark_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Space android:layout_width="match_parent" android:layout_height="8dp" />

            <ListView
                android:id="@+id/lvClientes"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:background="@color/white" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>