<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ECOLIM">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ECOLIM"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".DashboardActivity" android:exported="false" android:theme="@style/Theme.ECOLIM" />
        <activity android:name=".ClientesActivity" android:exported="false" android:theme="@style/Theme.ECOLIM" />
        <activity android:name=".UbicacionesActivity" android:exported="false" android:theme="@style/Theme.ECOLIM" />
        <activity android:name=".NuevaRecoleccionActivity" android:exported="false" android:theme="@style/Theme.ECOLIM" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".AgregarResiduosActivity" android:exported="false" android:theme="@style/Theme.ECOLIM" />
        <activity android:name=".DetalleResiduoActivity" android:exported="false" android:theme="@style/Theme.ECOLIM" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ResumenRecoleccionActivity" android:exported="false" android:theme="@style/Theme.ECOLIM" />
        <activity android:name=".ConfirmacionActivity" android:exported="false" android:theme="@style/Theme.ECOLIM" />
        <activity android:name=".ReportesActivity" android:exported="false" android:theme="@style/Theme.ECOLIM" />
        <activity android:name=".HistorialActivity" android:exported="false" android:theme="@style/Theme.ECOLIM" />
        <activity android:name=".ConfiguracionActivity" android:exported="false" android:theme="@style/Theme.ECOLIM" />

    </application>

</manifest>
